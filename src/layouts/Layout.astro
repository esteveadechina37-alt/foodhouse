---
import '../styles/global.css';
---

<!doctype html>
<html lang="fr" prefix="og: https://ogp.me">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Référencement Google standard -->
    <title>FoodHouse — Restaurant Africain à Porto-Novo</title>
    <meta name="description" content="FoodHouse, restaurant africain à Porto-Novo. Cuisine béninoise authentique, plats signatures, ambiance chaleureuse. Réservez votre table dès maintenant." />
    <link rel="canonical" href="https://foodhouse-omega.vercel.app/" />

    <!-- Configuration Open Graph (WhatsApp, Facebook, LinkedIn) -->
    <meta property="og:type" content="restaurant" />
    <meta property="og:title" content="FoodHouse — Restaurant Africain à Porto-Novo" />
    <meta property="og:description" content="Cuisine béninoise authentique, plats signatures, ambiance chaleureuse. Réservez votre table dès maintenant." />
    <meta property="og:url" content="https://foodhouse-omega.vercel.app/" />
    <meta property="og:locale" content="fr_FR" />
    
    <!-- Injection de l'image absolue et propriétés de rendu forcé -->
    <meta property="og:image" content="https://foodhouse-omega.vercel.app/images/plats/image_56b6d48b.jpg" />
    <meta property="og:image:secure_url" content="https://foodhouse-omega.vercel.app/images/plats/image_56b6d48b.jpg" />
    <meta property="og:image:type" content="image/jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Configuration Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="FoodHouse — Restaurant Africain à Porto-Novo" />
    <meta name="twitter:description" content="Cuisine béninoise authentique, plats signatures, ambiance chaleureuse." />
    <meta name="twitter:image" content="https://foodhouse-omega.vercel.app/images/plats/image_56b6d48b.jpg" />

    <script src="https://cdn.fedapay.com/checkout.js?v=1.1.7"></script>
  </head>
  <body class="bg-noir text-creme font-sans">
    <slot />
  </body>
</html>
