<!-- ============================================================
     SCRIPT — Carrousel + FedaPay + WhatsApp + Reveal
     ============================================================ -->
<script is:inline>
  (function () {
    'use strict';

    const form = document.getElementById('reservation-form');
    if (!form) return;

    const track       = form.querySelector('.rsv-track');
    const backBtn     = document.getElementById('rsv-back');
    const nextBtn     = document.getElementById('rsv-next');
    const submitBtn   = document.getElementById('rsv-submit');
    const steps       = form.querySelectorAll('.rsv-progress-step');
    const lines       = form.querySelectorAll('.rsv-progress-line');
    const whatsappNumber = '2290196977215';

    let currentStep = 1;
    const totalSteps = 3;

    /* ---------- Sécurité téléphone Bénin ---------- */
    function normaliserTelBenin(tel) {
      let n = tel.replace(/[^0-9]/g, '');
      if (n.startsWith('229')) n = n.slice(3);
      if (!n.startsWith('01')) n = '01' + n;
      return '+229' + n;
    }

    /* ---------- Navigation entre étapes ---------- */
    function setStep(step) {
      currentStep = Math.max(1, Math.min(totalSteps, step));
      track.setAttribute('data-step', String(currentStep));

      steps.forEach((s) => {
        const n = Number(s.getAttribute('data-step'));
        s.classList.toggle('is-active', n === currentStep);
        s.classList.toggle('is-done', n < currentStep);
      });

      lines.forEach((l) => {
        const n = Number(l.getAttribute('data-line'));
        l.classList.toggle('is-filled', n < currentStep);
      });

      backBtn.style.display = currentStep === 1 ? 'none' : 'inline-flex';
      nextBtn.style.display = currentStep === totalSteps ? 'none' : 'inline-flex';
      submitBtn.style.display = currentStep === totalSteps ? 'inline-flex' : 'none';

      const activeSlide = form.querySelector(`.rsv-slide[data-slide="${currentStep}"]`);
      const firstInput = activeSlide?.querySelector('input:not([type="hidden"]), textarea');
      if (firstInput) setTimeout(() => firstInput.focus(), 350);

      if (currentStep === totalSteps) {
        const formData = new FormData(form);
        const dateVal = formData.get('date');
        const dateFmt = dateVal
          ? (() => {
              const [y, m, d] = dateVal.split('-');
              return `${d}/${m}/${y}`;
            })()
          : '—';

        form.querySelector('[data-recap="date"]').textContent = dateFmt;
        form.querySelector('[data-recap="heure"]').textContent = formData.get('heure') || '—';
        form.querySelector('[data-recap="couverts"]').textContent =
          (formData.get('couverts') || '—') + ' pers.';
        form.querySelector('[data-recap="name"]').textContent = formData.get('name') || '—';
        form.querySelector('[data-recap="phone"]').textContent = formData.get('phone') || '—';
      }
    }

    /* ---------- Validation ---------- */
    function validateStep(step) {
      const slide = form.querySelector(`.rsv-slide[data-slide="${step}"]`);
      if (!slide) return true;

      const requiredFields = slide.querySelectorAll('input[required], textarea[required]');
      for (const field of requiredFields) {
        if (!field.value.trim()) {
          field.focus();
          field.style.borderBottomColor = 'rgba(249,246,240,.9)';
          setTimeout(() => (field.style.borderBottomColor = ''), 900);
          return false;
        }
      }
      return true;
    }

    nextBtn.addEventListener('click', () => {
      if (!validateStep(currentStep)) return;
      setStep(currentStep + 1);
    });

    backBtn.addEventListener('click', () => setStep(currentStep - 1));

    /* ---------- Segmented couverts ---------- */
    const segmentedBtns = form.querySelectorAll('.rsv-segmented-btn');
    const couvertsInput = document.getElementById('couverts');

    segmentedBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        segmentedBtns.forEach((b) => b.classList.remove('is-active'));
        btn.classList.add('is-active');
        couvertsInput.value = btn.getAttribute('data-value') || '2';
      });
    });

    /* ---------- Soumission + FedaPay ---------- */
    form.addEventListener('submit', (event) => {
      event.preventDefault();

      if (!validateStep(1) || !validateStep(2)) {
        setStep(!form.querySelector('[data-slide="1"] input:invalid') ? 2 : 1);
        return;
      }

      const formData = new FormData(form);
      const name     = formData.get('name');
      const phone    = formData.get('phone');
      const email    = formData.get('email');
      const date     = formData.get('date');
      const heure    = formData.get('heure');
      const couverts = formData.get('couverts');
      const message  = formData.get('message') || 'Aucune';

      const [year, month, day] = date.split('-');
      const dateFormatted = `${day}/${month}/${year}`;

      const parts = name.trim().split(' ');
      const prenom = parts[0] || name;
      const nomFamille = parts.slice(1).join(' ') || name;

      if (typeof window.FedaPay === 'undefined') {
        alert("Le module de paiement FedaPay n'est pas disponible.");
        return;
      }

      const widget = window.FedaPay.init({
        public_key: 'pk_sandbox_PvSnrvtHYdCoNXQz-azTyeM8',
        transaction: {
          amount: 1500,
          description: `Acompte réservation FoodHouse - ${dateFormatted} ${heure}`
        },
        customer: {
          firstname: prenom,
          lastname: nomFamille,
          email: email,
          phone_number: {
            number: normaliserTelBenin(phone),
            country: 'bj'
          }
        },
        onComplete: (resp) => {
          if (resp && resp.reason === window.FedaPay.CHECKOUT_COMPLETED) {
            const rawText =
`Nouvelle réservation FoodHouse (acompte payé ✅)

Nom : ${name}
Téléphone : ${normaliserTelBenin(phone)}
Email : ${email}
Date : ${dateFormatted}
Heure d'arrivée : ${heure}
Nombre de couverts : ${couverts}
Message : ${message}

Merci de me confirmer la réservation.`;

            window.location.href = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(rawText)}`;
          } else {
            alert("Le paiement de l'acompte n'a pas abouti. Merci de réessayer.");
          }
        }
      });

      if (widget && typeof widget.open === 'function') widget.open();
      else alert("Impossible d'ouvrir le paiement FedaPay.");
    });

    /* ---------- Reveal au scroll ---------- */
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target
            .querySelectorAll('.contact-reveal')
            .forEach((node) => node.classList.add('reveal-active'));
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });

    const target = document.getElementById('contact-observer');
    if (target) observer.observe(target);

    /* ---------- Init ---------- */
    setStep(1);
  })();
</script>