---
// Section Contact & Réservation — FoodHouse · Premium Booking Wizard
---

<!-- ============================================================
     STYLES
     ============================================================ -->
<style is:global>
  :root {
    --rsv-creme: #f9f6f0;
    --rsv-vin: #630f25;
    --rsv-vin-dark: #430c1b;
    --rsv-noir: #090909;
    --rsv-ease: cubic-bezier(0.19, 1, 0.22, 1);
  }

  #reservation {
    position: relative;
    background:
      radial-gradient(circle at 15% 20%, rgba(9, 9, 9, .28), transparent 40%),
      radial-gradient(circle at 85% 80%, rgba(9, 9, 9, .22), transparent 38%),
      var(--rsv-vin);
    color: var(--rsv-creme);
    overflow: hidden;
  }

  /* ---------- DÉCORATIONS ---------- */
  .rsv-hairline-top,
  .rsv-hairline-bottom {
    position: absolute;
    left: 10%;
    right: 10%;
    height: 1px;
    pointer-events: none;
    z-index: 2;
  }
  .rsv-hairline-top {
    top: 0;
    background: linear-gradient(to right, transparent, rgba(249,246,240,.35), transparent);
  }
  .rsv-hairline-bottom {
    bottom: 0;
    background: linear-gradient(to right, transparent, rgba(249,246,240,.22), transparent);
  }

  .rsv-ghost {
    position: absolute;
    font-family: Georgia, serif;
    font-style: italic;
    font-weight: 200;
    color: rgba(249, 246, 240, .05);
    line-height: 1;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .rsv-ghost-1 { top: 8%; left: -2%; font-size: clamp(140px, 18vw, 240px); }
  .rsv-ghost-2 { bottom: 4%; right: -2%; font-size: clamp(110px, 14vw, 200px); }

  /* ---------- HEADER ---------- */
  .rsv-header {
    text-align: center;
    margin-bottom: 2.5rem;
    position: relative;
    z-index: 3;
  }

  .rsv-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: rgba(249,246,240,.75);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .6em;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }

  .rsv-eyebrow-line {
    width: 24px;
    height: 1px;
    background: rgba(249,246,240,.4);
  }

  .rsv-title {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 200;
    line-height: .95;
    letter-spacing: -.035em;
    margin: 0;
  }

  .rsv-title em {
    font-style: italic;
    font-weight: 300;
    color: rgba(249,246,240,.65);
  }

  .rsv-subtitle {
    max-width: 26rem;
    margin: 1rem auto 0;
    color: rgba(249,246,240,.5);
    font-size: .78rem;
    font-weight: 300;
    line-height: 1.7;
  }

  /* ---------- LAYOUT ---------- */
  .rsv-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
    position: relative;
    z-index: 3;
  }

  /* ---------- CARROUSEL ---------- */
  .rsv-carousel {
    position: relative;
    background: rgba(9, 9, 9, .32);
    border: 1px solid rgba(249,246,240,.1);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding: 1.75rem 2rem;
    box-shadow: 0 40px 100px rgba(0,0,0,.35);
  }

  /* ---------- PROGRESSION ---------- */
  .rsv-progress {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(249,246,240,.1);
  }

  .rsv-progress-step {
    display: flex;
    align-items: baseline;
    gap: .5rem;
    opacity: .3;
    transition: opacity .6s var(--rsv-ease);
  }

  .rsv-progress-step.is-active,
  .rsv-progress-step.is-done { opacity: 1; }

  .rsv-progress-num {
    font-family: Georgia, serif;
    font-style: italic;
    font-size: .78rem;
    color: rgba(249,246,240,.7);
  }

  .rsv-progress-step.is-active .rsv-progress-num { color: var(--rsv-creme); }

  .rsv-progress-label {
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: rgba(249,246,240,.6);
    white-space: nowrap;
  }

  .rsv-progress-line {
    flex: 1;
    height: 1px;
    background: rgba(249,246,240,.15);
    position: relative;
    overflow: hidden;
  }

  .rsv-progress-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--rsv-creme);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .8s var(--rsv-ease);
  }

  .rsv-progress-line.is-filled::after { transform: scaleX(1); }

  /* ---------- TRACK ---------- */
  .rsv-track-wrap {
    overflow: hidden;
    position: relative;
  }

  .rsv-track {
    display: flex;
    width: 300%;
    transition: transform .9s var(--rsv-ease);
  }

  .rsv-track[data-step="1"] { transform: translateX(0); }
  .rsv-track[data-step="2"] { transform: translateX(-33.3333%); }
  .rsv-track[data-step="3"] { transform: translateX(-66.6666%); }

  .rsv-slide {
    width: 33.3333%;
    flex-shrink: 0;
    padding-right: 2px;
  }

  /* ---------- SLIDE INTERNE ---------- */
  .rsv-slide-head {
    margin-bottom: 1.25rem;
    position: relative;
  }

  .rsv-slide-ghost {
    position: absolute;
    top: -1.5rem;
    left: -.5rem;
    font-family: Georgia, serif;
    font-style: italic;
    font-size: 4rem;
    line-height: 1;
    font-weight: 200;
    color: rgba(249,246,240,.05);
    pointer-events: none;
    user-select: none;
  }

  .rsv-slide-title {
    font-family: Georgia, serif;
    font-size: 1.4rem;
    font-weight: 300;
    letter-spacing: -.01em;
    margin: 0 0 .35rem;
    position: relative;
  }

  .rsv-slide-title em {
    font-style: italic;
    color: rgba(249,246,240,.65);
  }

  .rsv-slide-desc {
    font-size: .75rem;
    font-weight: 300;
    line-height: 1.6;
    color: rgba(249,246,240,.5);
    max-width: 22rem;
    margin: 0;
  }

  /* ---------- CHAMPS ---------- */
  .rsv-field {
    display: flex;
    flex-direction: column;
    gap: .35rem;
    margin-bottom: .9rem;
  }

  .rsv-label {
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .3em;
    text-transform: uppercase;
    color: rgba(249,246,240,.55);
  }

  .rsv-input,
  .rsv-textarea {
    width: 100%;
    padding: .6rem 0;
    border: 0;
    border-bottom: 1px solid rgba(249,246,240,.2);
    background: transparent;
    color: var(--rsv-creme);
    font-family: inherit;
    font-size: .9rem;
    font-weight: 300;
    outline: none;
    transition:
      border-color .5s var(--rsv-ease),
      background-color .5s var(--rsv-ease);
  }

  .rsv-input::placeholder,
  .rsv-textarea::placeholder { color: rgba(249,246,240,.3); }

  .rsv-input:focus,
  .rsv-textarea:focus {
    border-bottom-color: var(--rsv-creme);
    background: rgba(249,246,240,.02);
  }

  .rsv-textarea {
    resize: none;
    line-height: 1.55;
  }

  /* ---------- SEGMENTED (couverts) ---------- */
  .rsv-segmented {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: .3rem;
  }

  .rsv-segmented-btn {
    padding: .5rem .2rem;
    border: 1px solid rgba(249,246,240,.15);
    background: transparent;
    color: rgba(249,246,240,.6);
    cursor: pointer;
    font-family: inherit;
    font-size: .78rem;
    transition:
      background .4s var(--rsv-ease),
      border-color .4s var(--rsv-ease),
      color .4s var(--rsv-ease);
  }

  .rsv-segmented-btn:hover {
    border-color: rgba(249,246,240,.35);
    color: var(--rsv-creme);
  }

  .rsv-segmented-btn.is-active {
    background: var(--rsv-creme);
    border-color: var(--rsv-creme);
    color: var(--rsv-vin);
    font-weight: 600;
  }

  /* ---------- DATES / HEURE ---------- */
  .rsv-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .rsv-input::-webkit-calendar-picker-indicator {
    filter: invert(1) opacity(.55);
    cursor: pointer;
  }

  /* ---------- RÉCAP ---------- */
  .rsv-recap {
    border: 1px solid rgba(249,246,240,.12);
    background: rgba(9,9,9,.28);
    padding: .85rem 1.1rem;
    margin: .9rem 0 .5rem;
  }

  .rsv-recap-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: .35rem 0;
    border-bottom: 1px solid rgba(249,246,240,.08);
    font-size: .78rem;
  }

  .rsv-recap-row:last-child { border-bottom: 0; }

  .rsv-recap-key {
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .25em;
    text-transform: uppercase;
    color: rgba(249,246,240,.5);
  }

  .rsv-recap-val {
    color: var(--rsv-creme);
    font-weight: 300;
    text-align: right;
  }

  /* ---------- NAVIGATION ---------- */
  .rsv-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 1px solid rgba(249,246,240,.1);
  }

  .rsv-back,
  .rsv-next,
  .rsv-submit {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    padding: .7rem 1.2rem;
    border: 1px solid transparent;
    background: transparent;
    color: rgba(249,246,240,.7);
    font-family: inherit;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: .26em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background .45s var(--rsv-ease),
      border-color .45s var(--rsv-ease),
      color .45s var(--rsv-ease),
      transform .45s var(--rsv-ease);
  }

  .rsv-back {
    border-color: rgba(249,246,240,.15);
    padding-left: .9rem;
    padding-right: 1rem;
  }

  .rsv-back:hover {
    border-color: rgba(249,246,240,.4);
    color: var(--rsv-creme);
  }

  .rsv-next {
    margin-left: auto;
    border-color: rgba(249,246,240,.4);
    color: var(--rsv-creme);
    position: relative;
    overflow: hidden;
  }

  .rsv-next::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--rsv-creme);
    transform: translateY(102%);
    transition: transform .6s var(--rsv-ease);
    z-index: 0;
  }

  .rsv-next:hover::before { transform: translateY(0); }

  .rsv-next > * {
    position: relative;
    z-index: 1;
  }

  .rsv-next:hover { color: var(--rsv-vin); }

  .rsv-next-arrow { transition: transform .45s var(--rsv-ease); }
  .rsv-next:hover .rsv-next-arrow { transform: translateX(4px); }

  .rsv-submit {
    margin-left: auto;
    background: var(--rsv-creme);
    color: var(--rsv-vin);
    border-color: var(--rsv-creme);
  }

  .rsv-submit:hover {
    background: #fff;
    transform: translateY(-2px);
    box-shadow: 0 16px 40px rgba(0,0,0,.3);
  }

  .rsv-submit svg { color: var(--rsv-vin); }

  /* ---------- INFOS ---------- */
  .rsv-infos {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .rsv-info-card {
    display: flex;
    align-items: flex-start;
    gap: 1.1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid rgba(249,246,240,.12);
    transition: padding-left .5s var(--rsv-ease);
  }

  .rsv-info-card:hover { padding-left: .4rem; }

  .rsv-info-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(249,246,240,.22);
    border-radius: 50%;
    color: var(--rsv-creme);
    transition:
      background .5s var(--rsv-ease),
      color .5s var(--rsv-ease),
      transform .5s var(--rsv-ease);
  }

  .rsv-info-card:hover .rsv-info-icon {
    background: var(--rsv-creme);
    color: var(--rsv-vin);
    transform: rotate(-8deg);
  }

  .rsv-info-eyebrow {
    font-size: 8px;
    font-weight: 700;
    letter-spacing: .35em;
    text-transform: uppercase;
    color: rgba(249,246,240,.5);
    margin-bottom: .25rem;
  }

  .rsv-info-title {
    font-family: Georgia, serif;
    font-size: 1rem;
    font-weight: 300;
    margin: 0 0 .25rem;
  }

  .rsv-info-text {
    font-size: .78rem;
    font-weight: 300;
    line-height: 1.6;
    color: rgba(249,246,240,.6);
    margin: 0;
  }

  .rsv-info-link {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    margin-top: .45rem;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: .2em;
    text-transform: uppercase;
    color: rgba(249,246,240,.75);
    border-bottom: 1px solid rgba(249,246,240,.3);
    padding-bottom: 2px;
    transition: color .3s ease, border-color .3s ease;
  }

  .rsv-info-link:hover {
    color: var(--rsv-creme);
    border-color: var(--rsv-creme);
  }

  .rsv-hours-row {
    display: flex;
    justify-content: space-between;
    font-size: .78rem;
    color: rgba(249,246,240,.55);
    padding: .15rem 0;
  }

  .rsv-hours-row strong {
    color: rgba(249,246,240,.85);
    font-weight: 400;
  }

  /* ---------- RÉVÉLATION ---------- */
  .contact-reveal {
    opacity: 0;
    transform: translateY(30px);
    filter: blur(4px);
    transition:
      opacity 1.2s var(--rsv-ease),
      transform 1.2s var(--rsv-ease),
      filter 1.2s var(--rsv-ease);
    will-change: transform, opacity, filter;
  }

  .contact-reveal.reveal-active {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  /* ---------- RESPONSIVE ---------- */
  @media (max-width: 1024px) {
    .rsv-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .rsv-carousel { padding: 1.5rem; }
    .rsv-ghost-1 { font-size: 140px; }
    .rsv-ghost-2 { font-size: 110px; }
  }

  @media (max-width: 767px) {
    .rsv-header { margin-bottom: 2rem; }
    .rsv-title { font-size: clamp(1.9rem, 9vw, 2.6rem); }
    .rsv-carousel { padding: 1.25rem; }

    .rsv-progress { gap: .4rem; margin-bottom: 1.25rem; padding-bottom: .85rem; }
    .rsv-progress-label { display: none; }
    .rsv-progress-num { font-size: .72rem; }

    .rsv-slide-ghost {
      font-size: 3rem;
      top: -1rem;
    }

    .rsv-slide-title { font-size: 1.2rem; }
    .rsv-slide-desc { font-size: .72rem; }

    .rsv-row-2 { gap: .9rem; }

    .rsv-segmented { gap: .22rem; }
    .rsv-segmented-btn {
      padding: .45rem .1rem;
      font-size: .72rem;
    }

    .rsv-field { margin-bottom: .8rem; }
    .rsv-input, .rsv-textarea { padding: .55rem 0; font-size: .85rem; }

    .rsv-nav {
      flex-direction: column-reverse;
      align-items: stretch;
      gap: .6rem;
      margin-top: .9rem;
      padding-top: .85rem;
    }

    .rsv-back,
    .rsv-next,
    .rsv-submit {
      justify-content: center;
      width: 100%;
      margin: 0;
      padding: .7rem 1rem;
    }

    .rsv-info-card { padding: .85rem 0; }
    .rsv-info-icon { width: 34px; height: 34px; }

    .rsv-ghost-1,
    .rsv-ghost-2 { display: none; }
  }

  /* ---------- REDUCED MOTION ---------- */
  @media (prefers-reduced-motion: reduce) {
    .contact-reveal {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }

    .rsv-track,
    .rsv-next::before,
    .rsv-info-icon,
    .rsv-info-card {
      transition: none;
    }
  }
</style>

<!-- ============================================================
     SECTION
     ============================================================ -->
<section id="reservation" class="py-16 md:py-24">

  <div class="rsv-hairline-top" aria-hidden="true"></div>
  <div class="rsv-hairline-bottom" aria-hidden="true"></div>

  <span class="rsv-ghost rsv-ghost-1" aria-hidden="true">02</span>
  <span class="rsv-ghost rsv-ghost-2" aria-hidden="true">✦</span>

  <div class="max-w-6xl mx-auto px-6 md:px-10 relative z-10" id="contact-observer">

    <!-- HEADER -->
    <header class="rsv-header contact-reveal">
      <span class="rsv-eyebrow">
        <span class="rsv-eyebrow-line"></span>
        Nous trouver
        <span class="rsv-eyebrow-line"></span>
      </span>

      <h2 class="rsv-title">
        Réservez <em>votre table</em>
      </h2>

      <p class="rsv-subtitle">
        Trois étapes, quelques secondes. Nous vous répondons ensuite
        sur WhatsApp pour confirmer votre venue.
      </p>
    </header>

    <div class="rsv-grid">

      <!-- ============================
           CARROUSEL FORMULAIRE
           ============================ -->
      <div class="contact-reveal" style="transition-delay:.1s;">

        <form id="reservation-form" class="rsv-carousel">

          <!-- PROGRESSION -->
          <div class="rsv-progress" aria-hidden="true">
            <div class="rsv-progress-step is-active" data-step="1">
              <span class="rsv-progress-num">01</span>
              <span class="rsv-progress-label">Le moment</span>
            </div>
            <div class="rsv-progress-line" data-line="1"></div>
            <div class="rsv-progress-step" data-step="2">
              <span class="rsv-progress-num">02</span>
              <span class="rsv-progress-label">Coordonnées</span>
            </div>
            <div class="rsv-progress-line" data-line="2"></div>
            <div class="rsv-progress-step" data-step="3">
              <span class="rsv-progress-num">03</span>
              <span class="rsv-progress-label">Confirmation</span>
            </div>
          </div>

          <!-- TRACK -->
          <div class="rsv-track-wrap">
            <div class="rsv-track" data-step="1">

              <!-- =====================
                   ÉTAPE 1 — LE MOMENT
                   ===================== -->
              <div class="rsv-slide" data-slide="1">
                <div class="rsv-slide-head">
                  <span class="rsv-slide-ghost" aria-hidden="true">01</span>
                  <h3 class="rsv-slide-title">
                    Quand souhaitez-vous <em>venir</em> ?
                  </h3>
                  <p class="rsv-slide-desc">
                    Choisissez votre date, votre heure d'arrivée
                    et le nombre de convives.
                  </p>
                </div>

                <div class="rsv-row-2">
                  <div class="rsv-field">
                    <label class="rsv-label" for="date">Date</label>
                    <input
                      type="date"
                      id="date"
                      name="date"
                      required
                      class="rsv-input"
                    />
                  </div>

                  <div class="rsv-field">
                    <label class="rsv-label" for="heure">Heure d'arrivée</label>
                    <input
                      type="time"
                      id="heure"
                      name="heure"
                      required
                      class="rsv-input"
                    />
                  </div>
                </div>

                <div class="rsv-field">
                  <label class="rsv-label">Couverts</label>
                  <div class="rsv-segmented" id="couverts-segmented">
                    <button type="button" class="rsv-segmented-btn" data-value="1">1</button>
                    <button type="button" class="rsv-segmented-btn is-active" data-value="2">2</button>
                    <button type="button" class="rsv-segmented-btn" data-value="3">3</button>
                    <button type="button" class="rsv-segmented-btn" data-value="4">4</button>
                    <button type="button" class="rsv-segmented-btn" data-value="5">5</button>
                    <button type="button" class="rsv-segmented-btn" data-value="6+">6+</button>
                  </div>
                  <input type="hidden" id="couverts" name="couverts" value="2" />
                </div>
              </div>

              <!-- =====================
                   ÉTAPE 2 — COORDONNÉES
                   ===================== -->
              <div class="rsv-slide" data-slide="2">
                <div class="rsv-slide-head">
                  <span class="rsv-slide-ghost" aria-hidden="true">02</span>
                  <h3 class="rsv-slide-title">
                    Faisons <em>connaissance</em>
                  </h3>
                  <p class="rsv-slide-desc">
                    Ces informations nous permettent de vous joindre
                    si nécessaire.
                  </p>
                </div>

                <div class="rsv-field">
                  <label class="rsv-label" for="name">Nom complet</label>
                  <input
                    type="text"
                    id="name"
                    name="name"
                    required
                    placeholder="Votre nom"
                    autocomplete="name"
                    class="rsv-input"
                  />
                </div>

                <div class="rsv-field">
                  <label class="rsv-label" for="phone">Téléphone</label>
                  <input
                    type="tel"
                    id="phone"
                    name="phone"
                    required
                    placeholder="+229 01 96 97 72 15"
                    autocomplete="tel"
                    class="rsv-input"
                  />
                </div>

                <div class="rsv-field">
                  <label class="rsv-label" for="email">Email</label>
                  <input
                    type="email"
                    id="email"
                    name="email"
                    required
                    placeholder="votre@email.com"
                    autocomplete="email"
                    class="rsv-input"
                  />
                </div>
              </div>

              <!-- =====================
                   ÉTAPE 3 — CONFIRMATION
                   ===================== -->
