---
// Section Galerie — FoodHouse · Premium 3D (architecture safe-first)
// Mobile : 2 colonnes avec décalage alterné
---

<style is:global>
  /* Priorité au-dessus de Tailwind v4 */
  @layer galerie;

  @layer galerie {
    #galerie {
      position: relative;
      background:
        radial-gradient(circle at 15% 30%, rgba(99,15,37,.14), transparent 45%),
        radial-gradient(circle at 85% 70%, rgba(99,15,37,.10), transparent 40%),
        #0B0B0B;
      overflow: hidden;
      isolation: isolate;
    }

    /* --- Décorations --- */
    #galerie .gal-hairline {
      position: absolute;
      left: 6%; right: 6%;
      height: 1px;
      pointer-events: none;
      z-index: 2;
    }
    #galerie .gal-hairline-top {
      top: 0;
      background: linear-gradient(to right, transparent, rgba(99,15,37,.7), transparent);
    }
    #galerie .gal-hairline-bottom {
      bottom: 0;
      background: linear-gradient(to right, transparent, rgba(249,246,240,.2), transparent);
    }

    #galerie .gal-rules {
      position: absolute; inset: 0;
      z-index: 0;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      pointer-events: none;
      opacity: .035;
    }
    #galerie .gal-rules > div { border-right: 1px solid #f9f6f0; }
    #galerie .gal-rules > div:last-child { border-right: 0; }

    #galerie .gal-ghost {
      position: absolute;
      top: 4%; right: -3%;
      z-index: 0;
      font-family: Georgia, serif;
      font-style: italic;
      font-weight: 200;
      font-size: clamp(200px, 30vw, 460px);
      line-height: 1;
      color: rgba(249, 246, 240, .03);
      pointer-events: none;
      user-select: none;
    }

    #galerie .gal-marker {
      position: absolute;
      top: 12rem; left: 1.5rem;
      z-index: 3;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
      pointer-events: none;
    }
    #galerie .gal-marker-text {
      writing-mode: vertical-rl;
      font-size: 9px; font-weight: 700;
      letter-spacing: .55em; text-transform: uppercase;
      color: rgba(249,246,240,.35);
    }
    #galerie .gal-marker-line {
      width: 1px; height: 5rem;
      background: linear-gradient(to bottom, rgba(249,246,240,.4), transparent);
    }

    /* --- Header --- */
    #galerie .gal-header {
      position: relative; z-index: 3;
      margin-bottom: 5rem;
    }
    #galerie .gal-header-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: end;
    }
    #galerie .gal-eyebrow {
      display: inline-flex; align-items: center; gap: 12px;
      font-size: 9px; font-weight: 700;
      letter-spacing: .55em; text-transform: uppercase;
      color: rgba(249,246,240,.5);
      margin-bottom: 1.5rem;
    }
    #galerie .gal-eyebrow-dot {
      width: 5px; height: 5px; border-radius: 50%;
      background: #630f25;
      box-shadow: 0 0 14px rgba(99,15,37,.95);
    }
    #galerie .gal-title {
      font-family: Georgia, 'Times New Roman', serif;
      font-size: clamp(2.6rem, 6.5vw, 5.5rem);
      font-weight: 200; line-height: .95;
      letter-spacing: -.035em;
      color: #f9f6f0;
      margin: 0;
    }
    #galerie .gal-title em {
      display: block;
      font-style: italic; font-weight: 300;
      color: rgba(249,246,240,.65);
      padding-left: 1.5em;
    }
    #galerie .gal-lede {
      max-width: 20rem;
      padding-left: 1.5rem;
      border-left: 1px solid rgba(249,246,240,.15);
      font-size: .78rem; font-weight: 300;
      line-height: 1.85;
      color: rgba(249,246,240,.5);
    }

    /* --- Grille --- */
    #galerie .gal-grid {
      position: relative; z-index: 3;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: 1.75rem;
      row-gap: 4rem;
      align-items: start;
      perspective: 2200px;
      perspective-origin: 50% 35%;
    }

    #galerie .gal-card-1 { grid-column: 1 / span 5; }
    #galerie .gal-card-2 { grid-column: 7 / span 3; margin-top: 5rem; }
    #galerie .gal-card-3 { grid-column: 11 / span 2; margin-top: 10rem; }
    #galerie .gal-card-4 { grid-column: 1 / span 3; margin-top: 1rem; }
    #galerie .gal-card-5 { grid-column: 5 / span 4; margin-top: 4rem; }
    #galerie .gal-card-6 { grid-column: 10 / span 3; margin-top: 7rem; }
    #galerie .gal-card-7 { grid-column: 2 / span 5; margin-top: 3rem; }
    #galerie .gal-card-8 { grid-column: 8 / span 4; margin-top: 6rem; }

    /* --- Cell wrapper --- */
    #galerie .gal-cell {
      display: block;
      width: 100%;
      opacity: 1;
    }

    @media (prefers-reduced-motion: no-preference) {
      #galerie .gal-cell {
        animation: gal-fade 0.9s cubic-bezier(0.19,1,0.22,1) backwards;
      }
      #galerie .gal-cell-1 { animation-delay: .05s; }
      #galerie .gal-cell-2 { animation-delay: .12s; }
      #galerie .gal-cell-3 { animation-delay: .19s; }
      #galerie .gal-cell-4 { animation-delay: .12s; }
      #galerie .gal-cell-5 { animation-delay: .19s; }
      #galerie .gal-cell-6 { animation-delay: .26s; }
      #galerie .gal-cell-7 { animation-delay: .16s; }
      #galerie .gal-cell-8 { animation-delay: .23s; }
    }

    @keyframes gal-fade {
      from { opacity: 0; }
      to   { opacity: 1; }
    }

    /* --- Carte --- */
    #galerie .gal-card {
      position: relative;
      display: block;
      width: 100%;
      cursor: pointer;
      background: transparent;
      border: 0; padding: 0;
      text-align: left;
      font: inherit;
      color: inherit;
      outline: none;
      transform:
        rotateX(var(--rx, 0deg))
        rotateY(var(--ry, 0deg))
        translate3d(0, var(--ty, 0px), 0);
      transition: transform .9s cubic-bezier(0.19,1,0.22,1);
    }
    #galerie .gal-card:focus-visible .gal-frame {
      outline: 2px solid #630f25;
      outline-offset: 6px;
    }

    /* --- Frame --- */
    #galerie .gal-frame {
      position: relative;
      display: block;
      width: 100%;
      overflow: hidden;
      background: #0f0f0f;
      border: 1px solid rgba(249,246,240,.07);
      box-shadow:
        0 1px 0 rgba(249,246,240,.06) inset,
        0 40px 80px -20px rgba(0,0,0,.85),
        0 20px 40px -20px rgba(0,0,0,.55);
      transition:
        box-shadow 1s cubic-bezier(0.19,1,0.22,1),
        border-color .8s cubic-bezier(0.19,1,0.22,1);
    }
    #galerie .gal-card:hover .gal-frame {
      border-color: rgba(99,15,37,.55);
      box-shadow:
        0 1px 0 rgba(249,246,240,.1) inset,
        0 60px 120px -20px rgba(0,0,0,.9),
        0 30px 60px -20px rgba(99,15,37,.35),
        0 0 60px -10px rgba(99,15,37,.25);
    }
    #galerie .gal-frame::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 1px;
      background: linear-gradient(to right, transparent, rgba(249,246,240,.35), transparent);
      z-index: 6;
      pointer-events: none;
    }
    #galerie .gal-frame::after {
      content: '';
      position: absolute; inset: 0;
      border: 1px solid rgba(99,15,37,0);
      transition: border-color .8s cubic-bezier(0.19,1,0.22,1);
      pointer-events: none;
      z-index: 5;
    }
    #galerie .gal-card:hover .gal-frame::after {
      border-color: rgba(99,15,37,.75);
    }

    #galerie .gal-r-1 { aspect-ratio: 4 / 5; }
    #galerie .gal-r-2 { aspect-ratio: 3 / 4; }
    #galerie .gal-r-3 { aspect-ratio: 2 / 3; }
    #galerie .gal-r-4 { aspect-ratio: 3 / 4; }
    #galerie .gal-r-5 { aspect-ratio: 1 / 1; }
    #galerie .gal-r-6 { aspect-ratio: 4 / 5; }
    #galerie .gal-r-7 { aspect-ratio: 16 / 10; }
    #galerie .gal-r-8 { aspect-ratio: 4 / 5; }

    /* --- Image --- */
    #galerie .gal-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      filter: grayscale(1) contrast(1.08) brightness(.78);
      transform: scale(1.02);
      transition:
        filter 1.4s cubic-bezier(0.19,1,0.22,1),
        transform 1.6s cubic-bezier(0.19,1,0.22,1);
    }
    #galerie .gal-card:hover .gal-img {
      filter: grayscale(0) contrast(1.05) brightness(.98) saturate(1.05);
      transform: scale(1.06);
    }

    /* --- Veil + Halo --- */
    #galerie .gal-veil {
      position: absolute; inset: 0;
      z-index: 2;
      pointer-events: none;
      background: linear-gradient(to top, rgba(11,11,11,.92) 0%, rgba(11,11,11,.3) 42%, transparent 78%);
      opacity: .95;
      transition: opacity .9s cubic-bezier(0.19,1,0.22,1);
    }
    #galerie .gal-card:hover .gal-veil { opacity: .55; }

    #galerie .gal-halo {
      position: absolute; inset: 0;
      z-index: 3;
      pointer-events: none;
      background: radial-gradient(circle 220px at var(--hx, 50%) var(--hy, 50%), rgba(99,15,37,.4), transparent 70%);
      opacity: 0;
      transition: opacity .6s cubic-bezier(0.19,1,0.22,1);
    }
    #galerie .gal-card:hover .gal-halo { opacity: .55; }

    /* --- Num / Chip / Caption --- */
    #galerie .gal-num {
      position: absolute;
      top: 1rem; left: 1rem;
      z-index: 4;
      font-family: Georgia, serif;
      font-style: italic;
      font-size: .78rem;
      letter-spacing: .12em;
      color: rgba(249,246,240,.85);
      padding: .35rem .7rem;
      border: 1px solid rgba(249,246,240,.2);
      background: rgba(11,11,11,.45);
      transition:
        border-color .6s cubic-bezier(0.19,1,0.22,1),
        color .6s cubic-bezier(0.19,1,0.22,1),
        background .6s cubic-bezier(0.19,1,0.22,1);
    }
    #galerie .gal-card:hover .gal-num {
      border-color: rgba(99,15,37,.85);
      color: #f9f6f0;
      background: rgba(99,15,37,.35);
    }

    #galerie .gal-chip {
      position: absolute;
      right: 1rem; bottom: 5rem;
      z-index: 4;
      font-size: 8px; font-weight: 700;
      letter-spacing: .3em; text-transform: uppercase;
      color: #f9f6f0;
      padding: .5rem .85rem;
      border: 1px solid rgba(99,15,37,.7);
      background: rgba(11,11,11,.6);
      opacity: 0;
      transform: translateY(10px);
      transition:
        opacity .7s cubic-bezier(0.19,1,0.22,1),
        transform .7s cubic-bezier(0.19,1,0.22,1);
    }
    #galerie .gal-card:hover .gal-chip {
      opacity: 1;
      transform: translateY(0);
    }

    #galerie .gal-caption {
      position: absolute;
      left: 1.15rem; right: 1.15rem; bottom: 1.15rem;
      z-index: 4;
      transition: transform .9s cubic-bezier(0.19,1,0.22,1);
    }
    #galerie .gal-card:hover .gal-caption { transform: translateY(-4px); }

    #galerie .gal-caption-rule {
      display: flex; align-items: center;
      gap: .65rem;
      margin-bottom: .7rem;
    }
    #galerie .gal-caption-rule span {
      display: block;
      width: 1.75rem; height: 1px;
      background: linear-gradient(to right, rgba(99,15,37,.95), rgba(99,15,37,.2));
    }
    #galerie .gal-caption-rule em {
      font-family: Georgia, serif;
      font-style: italic;
      font-size: .72rem;
      color: rgba(249,246,240,.55);
    }
    #galerie .gal-caption-title {
      display: block;
      font-family: Georgia, serif;
      font-size: 1.15rem;
      font-weight: 400;
      line-height: 1.1;
      color: #f9f6f0;
      margin: 0 0 .35rem;
    }
    #galerie .gal-caption-sub {
      display: block;
      font-size: 8px;
      font-weight: 700;
      letter-spacing: .32em;
      text-transform: uppercase;
      color: rgba(249,246,240,.55);
    }

    /* --- Quote --- */
    #galerie .gal-quote {
      position: relative;
      z-index: 3;
      margin-top: 9rem;
      padding-top: 3.5rem;
      border-top: 1px solid rgba(249,246,240,.08);
      text-align: center;
    }
    #galerie .gal-quote-mark {
      display: inline-block;
      font-family: Georgia, serif;
      font-size: 3.5rem;
      font-style: italic;
      color: rgba(99,15,37,.85);
      line-height: 1;
      margin-bottom: 1rem;
    }
    #galerie .gal-quote-text {
      font-family: Georgia, serif;
      font-size: clamp(1.15rem, 2vw, 1.6rem);
      font-style: italic;
      font-weight: 300;
      line-height: 1.5;
      color: rgba(249,246,240,.75);
      max-width: 32rem;
      margin: 0 auto;
    }
    #galerie .gal-quote-author {
      display: block;
      margin-top: 1.5rem;
      font-size: 9px;
      font-weight: 700;
      letter-spacing: .45em;
      text-transform: uppercase;
      color: rgba(249,246,240,.4);
    }

    /* --- Lightbox --- */
    .gal-lightbox {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(6,6,6,.94);
      opacity: 0;
      visibility: hidden;
      transition: opacity .5s cubic-bezier(0.19,1,0.22,1), visibility 0s .5s;
      padding: 2rem;
    }
    .gal-lightbox.is-open {
      opacity: 1;
      visibility: visible;
      transition: opacity .5s cubic-bezier(0.19,1,0.22,1), visibility 0s;
    }
    .gal-lightbox-inner {
      position: relative;
      width: 100%;
      max-width: 68rem;
      transform: scale(.96);
      transition: transform .6s cubic-bezier(0.19,1,0.22,1);
    }
    .gal-lightbox.is-open .gal-lightbox-inner { transform: scale(1); }
    .gal-lightbox-img {
      display: block;
      width: 100%;
      height: auto;
      max-height: 78vh;
      object-fit: contain;
      filter: none;
    }
    .gal-lightbox-meta {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: 1.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(249,246,240,.12);
      margin-top: 1.5rem;
    }
    .gal-lightbox-title {
      font-family: Georgia, serif;
      font-size: 1.5rem;
      font-weight: 300;
      color: #f9f6f0;
      margin: 0;
    }
    .gal-lightbox-sub {
      font-size: 9px;
      font-weight: 700;
      letter-spacing: .35em;
      text-transform: uppercase;
      color: rgba(249,246,240,.55);
    }
    .gal-lightbox-close {
      position: absolute;
      top: -3rem;
      right: 0;
      width: 2.5rem;
      height: 2.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid rgba(249,246,240,.3);
      border-radius: 50%;
      background: transparent;
      color: rgba(249,246,240,.85);
      cursor: pointer;
      font-size: 1.2rem;
      transition: background .4s ease, color .4s ease, transform .4s ease;
    }
    .gal-lightbox-close:hover {
      background: #f9f6f0;
      color: #0B0B0B;
      transform: rotate(90deg);
    }

    body.gal-locked { overflow: hidden; }

    /* --- Tablette --- */
    @media (max-width: 1024px) {
      #galerie .gal-header-grid { grid-template-columns: 1fr; gap: 2rem; }
      #galerie .gal-lede { padding-left: 0; border-left: 0; max-width: 26rem; }
      #galerie .gal-grid {
        grid-template-columns: repeat(6, minmax(0, 1fr));
        column-gap: 1.25rem;
        row-gap: 3rem;
        perspective: 1400px;
      }
      #galerie .gal-card-1 { grid-column: 1 / span 3; margin-top: 0; }
      #galerie .gal-card-2 { grid-column: 4 / span 3; margin-top: 3rem; }
      #galerie .gal-card-3 { grid-column: 1 / span 2; margin-top: 0; }
      #galerie .gal-card-4 { grid-column: 3 / span 2; margin-top: 3rem; }
      #galerie .gal-card-5 { grid-column: 5 / span 2; margin-top: 0; }
      #galerie .gal-card-6 { grid-column: 1 / span 3; margin-top: 2rem; }
      #galerie .gal-card-7 { grid-column: 4 / span 3; margin-top: 4rem; }
      #galerie .gal-card-8 { grid-column: 1 / span 3; margin-top: 0; }
      #galerie .gal-marker { display: none; }
    }

    /* ============================================================
       MOBILE — 2 colonnes + zigzag + hauteurs réduites
       ============================================================ */
    @media (max-width: 767px) {
      #galerie { padding-top: 4rem; padding-bottom: 4rem; }
      #galerie .gal-header { margin-bottom: 2rem; }
      #galerie .gal-title em { padding-left: .5em; }
      #galerie .gal-lede { font-size: .75rem; }

      /* --- Grille 2 colonnes --- */
      #galerie .gal-grid {
        display: grid !important;
        grid-template-columns: 1fr 1fr;
        column-gap: .7rem;
        row-gap: 1.25rem;
        align-items: start;
        perspective: none;
        transform-style: flat;
      }

      /* --- Reset du positionnement desktop 12 colonnes --- */
      #galerie .gal-card-1,
      #galerie .gal-card-2,
      #galerie .gal-card-3,
      #galerie .gal-card-4,
      #galerie .gal-card-5,
      #galerie .gal-card-6,
      #galerie .gal-card-7,
      #galerie .gal-card-8 {
        grid-column: auto / auto !important;
        margin-top: 0;
      }

      /* --- Zigzag : cellules paires impaires en alternance ---
         Row 1 (01,02) : 02 descend
         Row 2 (03,04) : 03 descend  ← inverse
         Row 3 (05,06) : 06 descend
         Row 4 (07,08) : 07 descend  ← inverse
      */
      #galerie .gal-cell-2,
      #galerie .gal-cell-3,
      #galerie .gal-cell-6,
      #galerie .gal-cell-7 {
        margin-top: 2.25rem;
      }

      #galerie .gal-cell { animation: none; opacity: 1; }

      #galerie .gal-card {
        transform: none !important;
        transform-style: flat !important;
      }

      #galerie .gal-img {
        filter: grayscale(0) contrast(1.02) brightness(.95);
        transform: none;
      }

      #galerie .gal-veil { opacity: .5; }
      #galerie .gal-halo { display: none; }

      /* --- Hauteurs réduites --- */
      #galerie .gal-r-1 { aspect-ratio: 4 / 5; }
      #galerie .gal-r-2 { aspect-ratio: 4 / 5; }      /* était 3/4 */
      #galerie .gal-r-3 { aspect-ratio: 4 / 5; }      /* était 2/3 → réduction majeure */
      #galerie .gal-r-4 { aspect-ratio: 4 / 5; }      /* était 3/4 */
      #galerie .gal-r-5 { aspect-ratio: 1 / 1; }
      #galerie .gal-r-6 { aspect-ratio: 4 / 5; }
      #galerie .gal-r-7 { aspect-ratio: 4 / 3; }      /* format paysage conservé */
      #galerie .gal-r-8 { aspect-ratio: 4 / 5; }

      /* --- Badges + captions réduits --- */
      #galerie .gal-num {
        font-size: .58rem;
        padding: .2rem .45rem;
        top: .5rem;
        left: .5rem;
        letter-spacing: .08em;
      }

      #galerie .gal-chip {
        display: block;
        right: .5rem;
        top: .5rem;
        bottom: auto;
        opacity: .92;
        transform: none;
        font-size: 6px;
        letter-spacing: .18em;
        padding: .28rem .5rem;
        background: rgba(99,15,37,.6);
        border-color: rgba(99,15,37,.85);
      }

      #galerie .gal-caption {
        left: .6rem;
        right: .6rem;
        bottom: .6rem;
      }
      #galerie .gal-caption-rule {
        gap: .4rem;
        margin-bottom: .3rem;
      }
      #galerie .gal-caption-rule span { width: 1rem; }
      #galerie .gal-caption-rule em { font-size: .58rem; }
      #galerie .gal-caption-title {
        font-size: .82rem;
        margin-bottom: .15rem;
      }
      #galerie .gal-caption-sub {
        font-size: 6px;
        letter-spacing: .2em;
      }

      /* --- Quote + Ghost --- */
      #galerie .gal-quote { margin-top: 4rem; padding-top: 2.5rem; }
      #galerie .gal-quote-text { font-size: 1rem; }
      #galerie .gal-quote-mark { font-size: 2.5rem; }
      #galerie .gal-ghost { display: none; }
      #galerie .gal-marker { display: none; }

      /* --- Lightbox --- */
      .gal-lightbox { padding: 1rem; }
      .gal-lightbox-close { top: -2.75rem; }
      .gal-lightbox-meta {
        flex-direction: column;
        gap: .5rem;
        align-items: flex-start;
      }
    }

    /* --- Reduced motion --- */
    @media (prefers-reduced-motion: reduce) {
      #galerie .gal-cell { animation: none; opacity: 1; }
      #galerie .gal-card { transform: none; transition: none; }
      #galerie .gal-img,
      #galerie .gal-veil,
      #galerie .gal-halo,
      #galerie .gal-chip,
      #galerie .gal-caption,
      #galerie .gal-frame,
      #galerie .gal-num { transition: none; }
    }
  }
</style>

<section id="galerie" class="relative py-32 overflow-hidden">

  <div class="gal-hairline gal-hairline-top" aria-hidden="true"></div>
  <div class="gal-hairline gal-hairline-bottom" aria-hidden="true"></div>
  <span class="gal-ghost" aria-hidden="true">03</span>
  <div class="gal-rules" aria-hidden="true"><div></div><div></div><div></div><div></div></div>
  <div class="gal-grain" aria-hidden="true"></div>

  <div class="gal-marker" aria-hidden="true">
    <span class="gal-marker-text">Chapitre 03 — Le Visuel</span>
    <span class="gal-marker-line"></span>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 lg:px-12">

    <header class="gal-header">
      <div class="gal-header-grid">
        <div>
          <span class="gal-eyebrow">
            <span class="gal-eyebrow-dot" aria-hidden="true"></span>
            Esthétique Culinaire
