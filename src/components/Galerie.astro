    <div class="gal-lightbox-meta">
      <h3 id="gal-lb-title" class="gal-lightbox-title"></h3>
      <span id="gal-lb-sub" class="gal-lightbox-sub"></span>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    'use strict';

    const section = document.getElementById('galerie');
    if (!section) return;

    const cards    = section.querySelectorAll('.gal-card');
    const lightbox = document.getElementById('gal-lightbox');
    const lbImg    = document.getElementById('gal-lb-img');
    const lbTitle  = document.getElementById('gal-lb-title');
    const lbSub    = document.getElementById('gal-lb-sub');
    const lbClose  = document.getElementById('gal-lb-close');

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer  = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const isDesktop    = window.innerWidth > 767;

    /* TILT 3D — desktop uniquement */
    if (finePointer && !reduceMotion && isDesktop) {
      cards.forEach((card) => {
        const frame = card.querySelector('.gal-frame');
        const halo  = card.querySelector('.gal-halo');
        if (!frame) return;

        let rafId = null;
        let tRX = 0, tRY = 0, tTY = 0;
        let cRX = 0, cRY = 0, cTY = 0;
        let tHX = 50, tHY = 50;
        let cHX = 50, cHY = 50;

        const onMove = (e) => {
          const r = frame.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width;
          const y = (e.clientY - r.top) / r.height;
          tRY = (x - 0.5) * 8;
          tRX = (0.5 - y) * 8;
          tTY = -6;
          tHX = x * 100; tHY = y * 100;
          if (rafId === null) rafId = requestAnimationFrame(tick);
        };

        const onLeave = () => {
          tRX = 0; tRY = 0; tTY = 0; tHX = 50; tHY = 50;
          if (rafId === null) rafId = requestAnimationFrame(tick);
        };

        const tick = () => {
          cRX += (tRX - cRX) * 0.12;
          cRY += (tRY - cRY) * 0.12;
          cTY += (tTY - cTY) * 0.12;
          cHX += (tHX - cHX) * 0.12;
          cHY += (tHY - cHY) * 0.12;

          card.style.setProperty('--rx', cRX.toFixed(3) + 'deg');
          card.style.setProperty('--ry', cRY.toFixed(3) + 'deg');
          card.style.setProperty('--ty', cTY.toFixed(2) + 'px');
          if (halo) {
            halo.style.setProperty('--hx', cHX.toFixed(2) + '%');
            halo.style.setProperty('--hy', cHY.toFixed(2) + '%');
          }

          const done =
            Math.abs(tRX - cRX) < 0.02 && Math.abs(tRY - cRY) < 0.02 &&
            Math.abs(tTY - cTY) < 0.1 && Math.abs(tHX - cHX) < 0.1 && Math.abs(tHY - cHY) < 0.1;
          if (done) { rafId = null; return; }
          rafId = requestAnimationFrame(tick);
        };

        card.addEventListener('pointermove', onMove);
        card.addEventListener('pointerleave', onLeave);
      });
    }

    /* LIGHTBOX */
    function openLightbox(src, title, sub, alt) {
      if (!lightbox || !lbImg) return;
      lbImg.src = src; lbImg.alt = alt || title || '';
      if (lbTitle) lbTitle.textContent = title || '';
      if (lbSub) lbSub.textContent = sub || '';
      lightbox.classList.add('is-open');
      document.body.classList.add('gal-locked');
      if (lbClose) setTimeout(() => lbClose.focus(), 100);
    }

    function closeLightbox() {
      if (!lightbox) return;
      lightbox.classList.remove('is-open');
      document.body.classList.remove('gal-locked');
      if (lbImg) lbImg.src = '';
    }

    cards.forEach((card) => {
      const open = () => {
        const img = card.querySelector('.gal-img');
        const src = card.getAttribute('data-img') || img?.getAttribute('src') || '';
        const tit = card.getAttribute('data-title') || '';
        const sub = card.getAttribute('data-sub') || '';
        const alt = img?.getAttribute('alt') || tit;
        if (src) openLightbox(src, tit, sub, alt);
      };
      card.addEventListener('click', open);
      card.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
      });
    });

    if (lbClose) lbClose.addEventListener('click', closeLightbox);
    if (lightbox) lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightbox?.classList.contains('is-open')) closeLightbox();
    });
  })();
</script>